<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>online_sfm</name>
  <version>1.0.0</version>
  <description>
    Online Structure from Motion (SfM) node optimized for endoscopic cameras.
    Performs real-time 3D reconstruction from stereo motion using SIFT features
    and triangulation. Optimized for 1080p endoscope with TF convention:
    Z-axis pointing out (forward), X-axis right, Y-axis down.
  </description>
  
  <maintainer email="your.email@example.com">Your Name</maintainer>
  <license>MIT</license>
  
  <author email="your.email@example.com">Your Name</author>

  <!-- Build dependencies -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  
  <!-- Runtime dependencies -->
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>pcl_conversions</depend>
  
  <!-- System dependencies -->
  <depend>libopencv-dev</depend>
  <depend>libpcl-dev</depend>
  <depend>libeigen3-dev</depend>
  
  <!-- Test dependencies -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>