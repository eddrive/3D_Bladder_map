<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>online_sfm</name>
  <version>0.0.1</version>
  <description>Online Structure-from-Motion using known camera pose with point accumulation and RANSAC filtering</description>
  <maintainer email="your.email@example.com">Your Name</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Core ROS dependencies -->
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  
  <!-- Image processing -->
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>libopencv-dev</depend>
  
  <!-- Transform handling -->
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  
  <!-- Point cloud processing -->
  <depend>pcl_conversions</depend>
  <depend>pcl_msgs</depend>
  <depend>libpcl-all-dev</depend>
  
  <!-- Linear algebra -->
  <depend>eigen3-cmake-module</depend>
  <depend>libeigen3-dev</depend>

  <!-- Testing -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>